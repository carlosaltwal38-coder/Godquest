    }

    .active {
      display: block;
    }

    .box {
      max-width: 700px;
      margin: 30px auto;
      padding: 25px;
      background: #1d2347;
      border-radius: 25px;
    }

    button {
      border: none;
      border-radius: 12px;
      padding: 15px 20px;
      margin: 8px;
      background: #765cff;
      color: white;
      font-size: 17px;
      font-weight: bold;
      cursor: pointer;
    }

    button:hover {
      background: #927dff;
    }

    input {
      padding: 15px;
      border-radius: 10px;
      border: none;
      width: 80%;
      max-width: 350px;
      font-size: 17px;
    }

    .heroes {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
      max-width: 650px;
      margin: auto;
    }

    .hero {
      background: #282f5b;
      padding: 20px;
      border-radius: 18px;
      cursor: pointer;
    }

    .hero.selected {
      outline: 4px solid #9b8cff;
    }

    .hero-icon {
      font-size: 60px;
    }

    .battle-icon {
      font-size: 100px;
    }

    .health {
      height: 20px;
      background: #333957;
      border-radius: 20px;
      overflow: hidden;
      margin: 10px 0 20px;
    }

    .health-bar {
      height: 100%;
      background: #55dc8a;
      width: 100%;
    }

    .enemy-bar {
      background: #ff596d;
    }

    .answers {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .answer {
      background: #29315d;
    }

    .correct {
      background: #16864d !important;
    }

    .wrong {
      background: #9d3040 !important;
    }

    .stats {
      font-size: 18px;
      margin: 15px;
    }

    @media(max-width:600px) {
      .heroes,
      .answers {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

